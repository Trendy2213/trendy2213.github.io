rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email == 'trendybag@hotmail.com';
    }

    function ownProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isApproved() {
      return signedIn()
        && ownProfile().approvalStatus == 'approved'
        && (
          ownProfile().get('requiresEmailVerification', false) != true
          || request.auth.token.email_verified == true
        );
    }

    match /catalog/public {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /catalog/settings {
      allow read: if isAdmin() || isApproved();
      allow write: if isAdmin();
    }

    match /catalog/{document=**} {
      allow read, write: if isAdmin();
    }

    match /productImages/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);

      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.approvalStatus == 'pending'
        && request.resource.data.requiresEmailVerification == true
        && request.resource.data.keys().hasOnly([
          'company', 'taxId', 'contact', 'email', 'phone', 'location',
          'business', 'website', 'message', 'approvalStatus',
          'requiresEmailVerification', 'requestedAt', 'source'
        ]);

      allow update: if isAdmin() || (
        isApproved()
        && request.auth.uid == userId
        && request.resource.data.approvalStatus == resource.data.approvalStatus
        && request.resource.data.get('requiresEmailVerification', false)
          == resource.data.get('requiresEmailVerification', false)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'company', 'taxId', 'contact', 'phone', 'address', 'city',
          'postalCode', 'country', 'email', 'uid', 'updatedAt'
        ])
      );

      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || (
        signedIn() && resource.data.customerUid == request.auth.uid
      );

      allow create: if (isAdmin() || isApproved())
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.customerEmail == request.auth.token.email
        && request.resource.data.status == 'Recibido'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 250
        && request.resource.data.minimumOrder == 100;

      allow update: if isAdmin() || (
        isApproved()
        && resource.data.customerUid == request.auth.uid
        && request.resource.data.customerUid == resource.data.customerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'quoteResponse', 'status', 'updatedAt'
        ])
        && request.resource.data.status in [
          'Presupuesto aceptado', 'Presupuesto rechazado'
        ]
      );

      allow delete: if isAdmin();
    }

    match /analytics/{eventId} {
      allow read: if isAdmin();
      allow create: if isApproved()
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
